# =============================================================================
# Open-Inspect - Cloudflare Deploy Settings
# =============================================================================
# Settings for scripts/cloudflare-deploy/deploy.mjs, which uploads the Worker
# code and configuration Terraform no longer manages. In GitHub Actions the
# deploy-<environment> workflows read these from the GitHub Environment
# (variables or secrets, falling back to repository-level ones) under exactly
# these names, which are the names the Terraform workflow used before.
#
# Local use:
#   cp scripts/cloudflare-deploy/deploy.env.example deploy.env   # never commit it
#   export CLOUDFLARE_API_TOKEN=...
#   node --env-file=deploy.env scripts/cloudflare-deploy/deploy.mjs --dry-run
#   node --env-file=deploy.env scripts/cloudflare-deploy/deploy.mjs
#
# Unset and empty values take the default shown. Defaults and validation live
# in scripts/cloudflare-deploy/config.mjs. Run the environment's Terraform
# apply first: the deploy looks up the D1 database, KV namespaces, queues and
# sandbox artifacts Terraform created.
# =============================================================================

# -----------------------------------------------------------------------------
# Deployment (must match the Terraform variables of the same meaning)
# -----------------------------------------------------------------------------
DEPLOYMENT_NAME=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_WORKER_SUBDOMAIN=
# vercel (default) or cloudflare. With cloudflare the deploy also builds and
# uploads the OpenNext web Worker.
WEB_PLATFORM=vercel
# modal (default), modal-vm, daytona, vercel, e2b or boat
SANDBOX_PROVIDER=modal
# Name of the Terraform-managed media bucket, when not open-inspect-media-<name>
R2_MEDIA_BUCKET_NAME=
APP_NAME=Open-Inspect
APP_ICON_URL=

# Custom domain for the Cloudflare web Worker (WEB_PLATFORM=cloudflare only).
# Requires a zone you control. Cloudflare provisions the DNS record and edge
# certificate, the web app URL becomes https://<hostname>, and workers.dev is
# disabled for the web Worker. Update the OAuth callback URLs to match.
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_CUSTOM_DOMAIN=

# Hold service bindings back on the very first deploy, when the control plane
# and the bots do not exist yet to bind each other; set true and deploy again.
ENABLE_SERVICE_BINDINGS=true

# -----------------------------------------------------------------------------
# GitHub App (always required) and sign-in providers (at least one pair)
# -----------------------------------------------------------------------------
GH_APP_ID=
# PKCS#8: openssl pkcs8 -topk8 -inform PEM -outform PEM -nocrypt -in key.pem -out key-pkcs8.pem
GH_APP_PRIVATE_KEY=
GH_APP_INSTALLATION_ID=
# GitHub sign-in: set both or neither. Callback: <web-app-url>/api/auth/callback/github
GH_OAUTH_CLIENT_ID=
GH_OAUTH_CLIENT_SECRET=
# Google sign-in: set both or neither. Callback: <web-app-url>/api/auth/callback/google
# Requires ALLOWED_EMAILS or ALLOWED_EMAIL_DOMAINS (or unsafe allow-all).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Access control
# -----------------------------------------------------------------------------
# A user is admitted if they match ANY list. These are deployment baseline
# rules, additive with SQL-managed rules (Settings > Workspace access); managed
# rules do not satisfy the deploy's safety checks. Set at least one list unless
# you intentionally opt into open access with UNSAFE_ALLOW_ALL_USERS=true.
ALLOWED_USERS=
ALLOWED_EMAIL_DOMAINS=
ALLOWED_EMAILS=
ALLOWED_GITHUB_ORGS=
UNSAFE_ALLOW_ALL_USERS=false

# -----------------------------------------------------------------------------
# Security secrets (generate with: openssl rand -base64 32)
# -----------------------------------------------------------------------------
TOKEN_ENCRYPTION_KEY=
REPO_SECRETS_ENCRYPTION_KEY=
# Browser authentication secret, at least 32 non-whitespace characters (legacy name)
NEXTAUTH_SECRET=

# Terraform generates these and keeps them in state. Copy them here (or into
# the GitHub Environment with sync-generated-secrets.mjs) from
#   terraform output -json generated_worker_secrets
# A Worker that already holds a value keeps it when the setting is left empty;
# a new Worker cannot deploy without them. PROVIDER_ACCOUNTS_ENCRYPTION_KEY
# must never change once provider account credentials are stored.
SERVICE_AUTH_SECRET_WEB=
SERVICE_AUTH_SECRET_SLACK_BOT=
SERVICE_AUTH_SECRET_GITHUB_BOT=
SERVICE_AUTH_SECRET_LINEAR_BOT=
IMAGE_CALLBACK_TOKEN_PEPPER=
PROVIDER_ACCOUNTS_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# Bots (keep ENABLE_* equal to the Terraform enable_*_bot variables)
# -----------------------------------------------------------------------------
ENABLE_SLACK_BOT=true
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
# Model for users with no saved preference: "provider/model" or bare claude-/gpt- id
SLACK_BOT_DEFAULT_MODEL=claude-haiku-4-5

ENABLE_GITHUB_BOT=false
# openssl rand -hex 32; the same value goes in the GitHub App's webhook settings
GH_WEBHOOK_SECRET=
# The App's slug plus "[bot]", e.g. open-inspect[bot]
GH_BOT_USERNAME=
GH_BOT_DEFAULT_MODEL=anthropic/claude-haiku-4-5

ENABLE_LINEAR_BOT=false
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
LINEAR_WEBHOOK_SECRET=
# Optional fallback for comment posting
LINEAR_API_KEY=
LINEAR_BOT_DEFAULT_MODEL=claude-sonnet-4-6

# -----------------------------------------------------------------------------
# Slack/Linear classifier
# -----------------------------------------------------------------------------
# claude-/anthropic/ ids use CLASSIFICATION_ANTHROPIC_API_KEY, falling back to
# ANTHROPIC_API_KEY; gpt-/openai/ ids use CLASSIFICATION_OPENAI_API_KEY;
# bedrock/<aws-region>/<inference-profile-id> uses CLASSIFICATION_BEDROCK_API_KEY.
CLASSIFICATION_MODEL=claude-haiku-4-5
ANTHROPIC_API_KEY=
CLASSIFICATION_ANTHROPIC_API_KEY=
CLASSIFICATION_OPENAI_API_KEY=
CLASSIFICATION_BEDROCK_API_KEY=
# OpenAI models only, e.g. low
CLASSIFICATION_REASONING_EFFORT=

# -----------------------------------------------------------------------------
# Control plane runtime
# -----------------------------------------------------------------------------
SANDBOX_INACTIVITY_TIMEOUT_MS=600000
# Minimum 60000
SANDBOX_UNATTENDED_INACTIVITY_TIMEOUT_MS=120000
# Must exceed 240000
SANDBOX_BOOT_TIMEOUT_MS=1800000
# off, shadow or on
TEAMS_ENFORCEMENT=shadow
# Empty, or wnam enam sam weur eeur apac apac-ne apac-se oc afr me
SESSION_DO_LOCATION_HINT=

# -----------------------------------------------------------------------------
# Sandbox providers (only the selected provider's settings are required;
# Daytona and Boat credentials stay bound after a provider switch)
# -----------------------------------------------------------------------------
MODAL_WORKSPACE=
MODAL_ENVIRONMENT=main
MODAL_ENVIRONMENT_WEB_SUFFIX=
MODAL_API_SECRET=

DAYTONA_API_URL=
DAYTONA_API_KEY=
# Same prefix and memory as the Terraform daytona_* variables: they name the snapshot
DAYTONA_BASE_SNAPSHOT=
DAYTONA_BASE_SNAPSHOT_MEMORY_GIB=2
DAYTONA_TARGET=
DAYTONA_TOOLBOX_API_URL=
# See docs/IMAGE_PREBUILD.md#daytona-prebuilds before enabling
DAYTONA_PREBUILDS_ENABLED=false

VERCEL_SANDBOX_TOKEN=
VERCEL_SANDBOX_PROJECT_ID=
VERCEL_SANDBOX_TEAM_ID=
VERCEL_SANDBOX_API_BASE_URL=
VERCEL_BASE_SNAPSHOT_ID=
VERCEL_SANDBOX_RUNTIME=node24
VERCEL_SNAPSHOT_EXPIRATION_MS=0

E2B_API_KEY=
E2B_API_URL=https://api.e2b.app
# Same template id, CPU and memory as the Terraform e2b_* variables
E2B_TEMPLATE_ID=
E2B_TEMPLATE_CPU=2
E2B_TEMPLATE_MEMORY_MB=4096
# 7200 assumes a paid plan; set 3300 on a plan with a one-hour cap
E2B_SANDBOX_TIMEOUT_SECONDS=7200
E2B_AUTO_PAUSE=true

BOAT_API_KEY=
BOAT_API_URL=https://boat.dev/api/v1
# Same prefix as the Terraform boat_base_snapshot variable
BOAT_BASE_SNAPSHOT=
BOAT_ORG=
# small, default, large or xlarge
BOAT_SANDBOX_TYPE=default
